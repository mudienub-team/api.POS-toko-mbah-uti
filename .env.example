# Application
PORT=3000
NODE_ENV=development
# "*" atau daftar origin dipisah koma
CORS_ORIGIN=*

# Database (runtime aplikasi - boleh lewat pooler)
DATABASE_URL="postgresql://user:password@host:5432/database"
# Koneksi langsung untuk migrasi Prisma (opsional, disarankan untuk Supabase)
DIRECT_URL="postgresql://user:password@host:5432/database"
# Kosongkan = otomatis (aktif kecuali host localhost)
# DATABASE_SSL=true
